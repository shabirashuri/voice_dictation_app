# Speech-to-text (required)
ASSEMBLYAI_API_KEY=

# Turn detection / voice activity
TURN_SILENCE_MS=3000
VAD_THRESHOLD=0.7

# LLM (Groq, OpenAI-compatible). Without GROQ_API_KEY the app falls back to a dummy LLM.
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_RETRIES=0
# json_schema (strict structured output) or json_object for models without schema support.
GROQ_RESPONSE_FORMAT=json_schema

# Database (Postgres). DATABASE_URL takes precedence over SUPABASE_DB_URL.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_URL=
DB_SSL=0

# Session lifecycle
# In-memory session state is dropped after this many idle seconds (backstop; it is
# also dropped when the WebSocket closes).
SESSION_TTL_SECONDS=3600
# WebSocket is closed after this many seconds with no client messages (dictation or review).
WS_IDLE_TIMEOUT_SECONDS=900

# Auth (JWT). JWT_SECRET is required: at least 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
BCRYPT_ROUNDS=12

# On Stop, wait this long for queued dictation chunks before finalizing
STOP_DRAIN_TIMEOUT_SECONDS=30
